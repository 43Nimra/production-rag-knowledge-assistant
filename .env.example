# Copy this file to .env and fill in real values before running
# `docker compose up`. .env is git-ignored and must never be committed.

# --- Database (Phase 1) ---
# Async driver scheme (postgresql+asyncpg://) is required by SQLAlchemy's
# async engine. Host "postgres" refers to the docker-compose service name;
# use "localhost" if running the API outside of Docker against a local DB.
DATABASE_URL=postgresql+asyncpg://rag:rag@postgres:5432/rag_db

# --- Auth / JWT (Phase 1) ---
JWT_SECRET_KEY=change-this-to-a-random-string-in-production
JWT_EXPIRE_HOURS=24
AUTH_USERNAME=admin
AUTH_PASSWORD=changeme

# --- Observability (Phase 1) ---
LOG_LEVEL=INFO

# --- Embeddings (used starting Phase 2 — not read by Phase 1 code) ---
EMBEDDER_PROVIDER=openai
EMBED_MODEL=text-embedding-3-small
OPENAI_API_KEY=your-openai-api-key-here

# --- LLM (used starting Phase 3/4 — not read by Phase 1 code) ---
LLM_PROVIDER=anthropic
LLM_MODEL=claude-haiku-4-5
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# --- Chunking / retrieval (used starting Phase 2/3 — not read by Phase 1 code) ---
CHUNK_SIZE=512
CHUNK_OVERLAP=64
TOP_K=5
